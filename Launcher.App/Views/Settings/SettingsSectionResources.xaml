<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
                    xmlns:settings="clr-namespace:Launcher.App.ViewModels.Settings">
    <Style x:Key="SettingsOptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SettingsDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="JavaSelectionOptionTemplate">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="DownloadSourceOptionTemplate"
                  DataType="{x:Type settings:SettingsDownloadSourceOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="UpdateChannelOptionTemplate"
                  DataType="{x:Type settings:SettingsUpdateChannelOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="ThemeOptionTemplate"
                  DataType="{x:Type settings:SettingsThemeOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="BackgroundEffectOptionTemplate"
                  DataType="{x:Type settings:SettingsBackgroundEffectOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="LanguageOptionTemplate"
                  DataType="{x:Type settings:SettingsLanguageOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="AccentColorPreviewEllipseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Blue}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Id}" Value="Cyan">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Cyan}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Green">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Emerald">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Emerald}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Purple">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Purple}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Pink">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Pink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Orange">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Orange}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Amber">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Amber}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="AccentColorOptionTemplate"
                  DataType="{x:Type settings:SettingsAccentColorOption}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource AccentColorPreviewEllipseStyle}" />
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.F4F4F4}"
                       FontSize="13"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FontOptionTemplate"
                  DataType="{x:Type settings:SettingsFontOption}">
        <TextBlock Text="{Binding Title}"
                   FontFamily="{Binding Id}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="JavaRuntimeListBoxStyle" TargetType="ListBox">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
        <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JavaRuntimeListBoxItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource DialogChoiceItemStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="IsHitTestVisible"
                Value="{Binding DataContext.IsJavaManualSelection, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
    </Style>

    <DataTemplate x:Key="JavaRuntimeItemTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="{DynamicResource Brush.F4F4F4}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding Architecture}"
                           Foreground="{DynamicResource Brush.CFFFFFFF}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,4,0,0"
                       Text="{Binding ExecutablePath}"
                       Foreground="{DynamicResource Brush.AFFFFFFF}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style x:Key="LauncherEditableComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.ComboBox.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MaxDropDownHeight" Value="260" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherComboBoxDropDownItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      IsTabStop="False">
                            <Border x:Name="Border"
                                    Background="{DynamicResource Brush.Card.Surface}"
                                    BorderBrush="{DynamicResource Brush.Input.ComboBox.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Border x:Name="HoverBackground"
                                            Background="{DynamicResource Brush.Button.Secondary.Hover}"
                                            CornerRadius="8"
                                            Opacity="0" />
                                    <Grid Margin="12,0,34,0">
                                        <TextBlock x:Name="PlaceholderText"
                                                   Text="输入或选择字体..."
                                                   Foreground="{DynamicResource Brush.AFFFFFFF}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed" />
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource Brush.F4F4F4}"
                                                 FontSize="13"
                                                 FontFamily="{DynamicResource LauncherFontFamily}"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource Brush.F4F4F4}" />
                                    </Grid>
                                    <TextBlock Margin="0,0,12,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource LauncherIconFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.CFFFFFFF}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                        </ToggleButton>
                        <Popup x:Name="Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding ElementName=ToggleButton}"
                               Placement="Bottom"
                               HorizontalOffset="-1"
                               VerticalOffset="-8"
                               PopupAnimation="None">
                            <Grid x:Name="PopupSurface"
                                  Margin="14"
                                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="Transparent"
                                        CornerRadius="9"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22"
                                                          Color="{DynamicResource Color.000000}"
                                                          Opacity="0.36"
                                                          ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource Brush.Surface.Flyout}"
                                        BorderBrush="{DynamicResource Brush.14FFFFFF}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        ClipToBounds="True" />
                                <ListBox x:Name="DropDownList"
                                         Margin="5"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource LauncherComboBoxDropDownItemStyle}"
                                         ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Items}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" />
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Input.ComboBox.BorderExpanded}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.165A5A5A}" />
                            <Setter Property="Opacity" Value="0.58" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="InteractiveControlItemTemplate"
                  DataType="{x:Type settings:SettingsInteractiveControlItem}">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.F4F4F4}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,3,0,0"
                       Text="{Binding Category}"
                       Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
